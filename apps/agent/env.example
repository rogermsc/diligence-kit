# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# OpenAI (GPT-5 Mini for vision OCR)
OPENAI_API_KEY=your-openai-api-key

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_CLOUD_BUCKET_NAME=your-bucket-name
GOOGLE_CLOUD_CREDENTIALS=/app/credentials/service-account.json

# Backend Configuration
# Use https:// in production
BACKEND_BASE_URL=http://localhost:3001

# JWT Authentication
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256

# Agent secret — signs outbound JWTs (must be 32+ chars)
AGENT_SECRET=your-agent-secret-min-32-chars-here

# API key — authenticates inbound requests via X-API-Key header (must be 32+ chars)
API_KEY=your-api-key-min-32-chars-here

# Webhook secret — HMAC-SHA256 signs backend callback payloads (must be 32+ chars, different from AGENT_SECRET)
WEBHOOK_SECRET=your-webhook-secret-min-32-chars-here

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Report branding — rendered into the header/footer of every generated DOCX
REPORT_PREPARED_BY=Your Organization

# Logging
LOG_LEVEL=INFO

# LLM driver: "openai" (default) calls the API; "replay" serves recorded
# responses from LLM_FIXTURE_DIR so the pipeline runs with no key.
LLM_DRIVER=openai
LLM_FIXTURE_DIR=fixtures/llm
# With LLM_DRIVER=openai, record every response for later replay.
LLM_RECORD=false

# Any OpenAI-compatible endpoint (Azure, vLLM, OpenRouter, a local server).
# OPENAI_BASE_URL=

# Model per purpose, rather than hardcoded at the call sites.
LLM_MODEL_FACT_EXTRACTION=gpt-5-mini
LLM_MODEL_CONFLICT_RESOLUTION=gpt-5-mini
LLM_MODEL_ONE_PAGER=gpt-5.2
LLM_MODEL_DILIGENCE_REPORT=gpt-5.2

# Storage driver: "gcs" (default) or "local".
STORAGE_DRIVER=gcs
STORAGE_LOCAL_ROOT=.data/storage

# How often to tell the backend an in-flight run is still alive. Must be
# comfortably below the backend's AUTOMATION_TIMEOUT_MINUTES.
HEARTBEAT_SECONDS=60
