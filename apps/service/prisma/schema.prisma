datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id              String       @id @default(uuid()) @db.Uuid
  // Unique per owner. Storage paths used to be namespaced by this name, which
  // made global uniqueness a security property and leaked the existence of other
  // tenants' company names at creation time — you learned one existed by being
  // refused. Paths are keyed on the id now, so the constraint is only what it
  // should have been: you cannot have two companies with the same name.
  name            String
  // Tenancy root. Every other record reaches its owner through this column
  // (Automation -> Company, Documents -> Automation -> Company, and so on), so
  // scoping a query by company ownership scopes the whole object graph.
  // Note: User.id is text, not uuid, so this column must match that type.
  owner           User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId         String
  automations     Automation[]
  reports         Report[]
  onePagers       OnePager[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([ownerId, name], name: "unique_owner_company_name")
  @@index([ownerId], name: "idx_company_owner")
  @@map("companies")
}

enum AutomationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  NOT_STARTED
}


enum AutomationStage {
  TRIAGE
  DILLIGENCE_OPERATIONAL
  DILLIGENCE_COMMERCIAL
  DILLIGENCE_FINANCIAL
  DILLIGENCE_CAP_TABLE_AND_LEGAL_REVIEW
}

model Automation {
  id        String           @id @default(uuid()) @db.Uuid
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String          @db.Uuid
  status    AutomationStatus @default(NOT_STARTED)
  stage     AutomationStage  @default(TRIAGE)
  
  // Self-referencing relation for parent-child automations
  parentAutomation   Automation? @relation("AutomationParent", fields: [parentAutomationId], references: [id])
  parentAutomationId String?     @db.Uuid
  childAutomations   Automation[] @relation("AutomationParent")

  // Last sign of life from the agent working on this run. The reaper compares
  // against this rather than updatedAt, which only records the last write and so
  // could not tell a slow healthy run from an abandoned one.
  heartbeatAt DateTime?

  results   Result[]
  reports   Report[]
  onePagers OnePager[]
  overrides AnalysisOverride[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  Documents Documents[]

  @@index([companyId], name: "idx_automation_company")
  @@index([parentAutomationId], name: "idx_automation_parent")
  @@index([status, heartbeatAt], name: "idx_automation_liveness")
  // @@index([stage], name: "idx_automation_stage")
  @@map("automations")
}

model Documents {
  id             String           @id @default(uuid()) @db.Uuid
  automation     Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationId   String          @db.Uuid
  outputDocuments OutputDocument[]
  name           String
  bucketPath     String
  openaiFileId   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([automationId, name])
  @@map("documents")
}

enum ResultStatus {
  OK
  MISSING_DOCS
}

enum OutputDocumentStatus {
  OK
  MISSING
  OPTIONAL
}

enum OutputSector {
  COMPANY_SUMMARY
  TEAM
  CORPORATE
  CLIENTS
  INVESTMENT
  LEGAL
  FINANCIAL
}

model Result {
  id           String     @id @default(uuid()) @db.Uuid
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationId String     @db.Uuid
  status       ResultStatus @default(OK)
  documents    OutputDocument[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([automationId], name: "idx_result_automation")
  @@map("results")
}

model OutputDocument {
  id           String     @id @default(uuid()) @db.Uuid
  result       Result     @relation(fields: [resultId], references: [id], onDelete: Cascade)
  resultId     String     @db.Uuid
  document     Documents? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId   String?    @db.Uuid
  name         String
  status       OutputDocumentStatus
  sector       OutputSector
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([resultId], name: "idx_output_document_result")
  @@index([documentId], name: "idx_output_document_document")
  @@map("output_documents")
}

model RefreshToken {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model User {
  id            String        @id @default(uuid())
  email         String       @unique
  password      String
  created_at    DateTime     @default(now())
  companyId     String?      @db.Uuid
  refreshTokens RefreshToken[]
  companies     Company[]
  overrides     AnalysisOverride[]

  @@map("users")
}

enum AgentType {
  OPERATIONAL
  COMMERCIAL
  FINANCIAL
  CAP_TABLE_AND_LEGAL_REVIEW
}

enum ReportStatus {
  COMPLETED
  FAILED
  UNTRACKED
}

model Report {
  id           String       @id @default(uuid()) @db.Uuid
  automation   Automation   @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationId String       @db.Uuid
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId    String       @db.Uuid
  domain       AgentType
  status       ReportStatus @default(UNTRACKED)
  reportUrl    String
  /// Same envelope as OnePager.analysis, carrying the domain report instead of
  /// the one-pager. Written now, read later — landing both columns in one
  /// migration avoids a second one racing this from a parallel branch.
  analysis     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([automationId], name: "idx_report_automation")
  @@index([companyId], name: "idx_report_company")
  @@index([domain], name: "idx_report_domain")
  @@unique([automationId, domain], name: "unique_automation_domain")
  @@map("reports")
}

model OnePager {
  id            String      @id @default(uuid()) @db.Uuid
  automation    Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationId  String      @db.Uuid @unique
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId     String      @db.Uuid
  url           String      @db.Text
  /// The structured analysis behind the PDF: every fact with its source file,
  /// page and verbatim quote, the coverage map, the resolved conflicts, and the
  /// one-pager sections including the weighted scorecard. Stored verbatim in
  /// the agent's shape — see apps/agent/src/domain/analyze/entities.py.
  ///
  /// ponytail: one document, not fact and conflict tables. Every write is a
  /// whole run and every read is a whole run, and nothing queries across runs.
  /// Normalise when that stops being true.
  ///
  /// Nullable: rows written before this column have only the PDF, and the read
  /// endpoint returns null rather than failing.
  analysis      Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([automationId], name: "idx_onepager_automation")
  @@index([companyId], name: "idx_onepager_company")
  @@map("one_pagers")
}

/// A human decision recorded on top of a run, never inside it.
///
/// The machine's analysis is a run artefact and is not edited: it stays exactly
/// as the agent produced it, in OnePager.analysis. Judgement about it lives
/// here, attributed and timestamped, and the read endpoint merges the two so
/// every value can say whether it came from the model or from a person.
///
/// That separation is the same discipline the product applies to a dataroom —
/// a figure is worth what its source is worth — turned on its own users. It
/// also makes the audit trail free, because this table *is* the trail.
model AnalysisOverride {
  id           String             @id @default(uuid()) @db.Uuid
  automation   Automation         @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationId String             @db.Uuid
  targetType   OverrideTargetType
  /// What is being overridden: a fact or conflict field name, or a scorecard
  /// category as "category:Financial Readiness".
  targetKey    String
  /// The replacement. Null for an ANNOTATION, which adds a note without
  /// changing a value, and for a revert, which withdraws an earlier override.
  value        Json?
  /// Required, at the schema level. An override with no stated reason is the
  /// unsourced assertion this product exists to argue against.
  rationale    String             @db.Text
  /// Restrict, not Cascade: deleting a user must not silently rewrite the
  /// history of a run they made decisions on.
  author       User               @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorId     String             @db.Uuid
  createdAt    DateTime           @default(now())

  @@index([automationId, targetType, targetKey], name: "idx_override_target")
  @@map("analysis_overrides")
}

enum OverrideTargetType {
  FACT
  CONFLICT
  SCORECARD
  ANNOTATION
}
