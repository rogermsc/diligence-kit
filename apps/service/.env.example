DATABASE_NAME=db_name
DATABASE_USER=user
DATABASE_PASSWORD=password

DB_PORT=5432
PORT=3001
DATABASE_URL="postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@localhost:5432/${DATABASE_NAME}?schema=public"

GOOGLE_APPLICATION_CREDENTIALS=./.gcp/credentials.json
GCLOUD_STORAGE_BUCKET=bucket_name

# Agent API
AGENT_API_URL="http://localhost:3001"
AGENT_API_KEY="changeme-agent-api-key"
AGENT_SECRET="changeme-agent-secret-minimum-32-chars!!"

# Webhook
WEBHOOK_SECRET="changeme-webhook-secret-minimum-32-chars!"

# Auth
JWT_SECRET="changeme-jwt-secret-minimum-32-chars!!!"
JWT_EXPIRES_IN="24h"
# Keep in step with the 7-day expiry written to the refresh_tokens row.
JWT_REFRESH_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6381

# Liaison Agent
LIAISON_AGENT_URL=http://localhost:8000
LIAISON_API_KEY=your-api-key-here

# Email
EMAIL_SENDER="sender@example.com"
EMAIL_DESTINATION="destination@example.com"

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=${EMAIL_DESTINATION}
SMTP_PASS=password
SMTP_SECURE=false
