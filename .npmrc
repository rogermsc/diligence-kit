# node-linker=hoisted produces a flat node_modules tree (npm-compatible).
# We use it because the apps (especially Nest's @nestjs/platform-express → multer)
# rely on transitive dependencies being directly resolvable — the way npm has
# always allowed. The default isolated linker breaks those imports.
node-linker=hoisted
strict-peer-dependencies=false
auto-install-peers=true
